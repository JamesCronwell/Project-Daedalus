# secrets never enter the repo
*.key
*.pem
.env
.env.*
id_*
*.kdbx
# raw scans: only the redacted, generated docs/inventory/*.md are committed
docs/inventory/raw/
scratch/
*.log
__pycache__/
.claude/settings.local.json
# chip sessions run in worktrees here
.claude/worktrees/
# Discord snapshots and screenshots hold friends' names: local only (BRIEF 03)
docs/discord/
# the owner opens the repo in Obsidian: its vault config stays local
.obsidian/
